{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "devenv: test",
      "type": "shell",
      "command": "nix",
      "args": ["run", "nixpkgs#devenv", "--", "test"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "devenv: format",
      "type": "shell",
      "command": "nix",
      "args": [
        "run",
        "nixpkgs#devenv",
        "--",
        "tasks",
        "run",
        "devenv:treefmt:run"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "nix: flake metadata",
      "type": "shell",
      "command": "nix",
      "args": ["flake", "metadata"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
